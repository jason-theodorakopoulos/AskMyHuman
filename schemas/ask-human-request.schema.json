{
  "$defs": {
    "RequestKind": {
      "enum": [
        "approval",
        "input"
      ],
      "title": "RequestKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "idempotencyKey": {
      "format": "uuid",
      "title": "Idempotencykey",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/RequestKind"
    },
    "phoneNumber": {
      "pattern": "^\\+[1-9]\\d{1,14}$",
      "title": "Phonenumber",
      "type": "string"
    },
    "prompt": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "prompt",
    "idempotencyKey",
    "phoneNumber"
  ],
  "title": "AskHumanRequest",
  "type": "object"
}
